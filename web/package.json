{
  "name": "decap-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "golden": "tsx scripts/golden.ts",
    "check-data": "tsx scripts/check-data.ts",
    "sync-data": "node scripts/sync-data.mjs",
    "mc-assets": "node scripts/mc-assets.mjs",
    "stage-data": "../.venv/bin/python -I ../decap/ingest/liberty.py && ../.venv/bin/python -I ../decap/ingest/ingest_gds.py --all",
    "stage-data:warmup": "../.venv/bin/python -I ../decap/ingest/liberty.py && ../.venv/bin/python -I ../decap/ingest/ingest_def.py"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/three": "0.160.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
